---
import ThemeControl from "@/components/ThemeControl.astro";
---

<header>
	<a class="name" href="/">Joel Rodríguez</a>
	<span class="role">Full-stack developer</span>
	<nav aria-label="Main">
		<a href="/projects/">Projects</a>
		<a href="/cv/">CV</a>
	</nav>
	<ThemeControl />
</header>

<style>
header {
	display: flex;
	flex-wrap: wrap;
	align-items: center;
	gap: 0.75rem;
	padding-block: 4rem 6rem;
}

@media (max-width: 48rem) {
	header {
		padding-bottom: 4rem;
	}
}

@media print {
	header {
		display: none;
	}
}

.name {
	font-weight: 600;
	text-decoration: none;
}

.role {
	color: var(--muted);
}

nav {
	display: flex;
	gap: 1.25rem;
	margin-left: auto;
}

nav a {
	color: var(--muted);
	text-decoration: none;
}

nav a:hover {
	color: var(--text);
}
</style>
