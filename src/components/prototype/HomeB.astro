---
// PROTOTYPE variant B, "Short columns" (paco.me): a large claim on top and the
// proof in short side-by-side columns, so the whole page fits one desktop screen.
import { claim, formatDate, latestPost, person, projects } from "./data";
---

<div class="b">
	<header>
		<p class="name">
			{person.name}<span>{person.role}</span>
		</p>
		<nav aria-label="Main">
			<a href="/projects">Projects</a>
			<a href="/cv">CV</a>
			<a href="/blog">Blog</a>
		</nav>
	</header>

	<main>
		<h1>{claim.before}<em class="accent">{claim.accent}</em>{claim.after}</h1>
		<p class="support">{claim.support}</p>

		<div class="columns">
			<section aria-labelledby="b-projects">
				<h2 id="b-projects">Projects</h2>
				<ul>
					{projects.map((project) => (
						<li>
							<a href={project.href}>{project.title}</a>
							<p>{project.summary}</p>
							<p class="meta">{project.status}</p>
						</li>
					))}
				</ul>
			</section>

			<section aria-labelledby="b-writing">
				<h2 id="b-writing">Writing</h2>
				<ul>
					<li>
						<a href={latestPost.href} lang={latestPost.lang}>
							{latestPost.title}
						</a>
						<p class="meta">
							<time datetime={latestPost.date}>
								{formatDate(latestPost.date)}
							</time>
						</p>
					</li>
				</ul>
			</section>

			<section aria-labelledby="b-contact">
				<h2 id="b-contact">Contact</h2>
				<ul>
					<li>
						<a href={`mailto:${person.email}`}>{person.email}</a>
					</li>
					<li><a href={person.linkedin}>LinkedIn</a></li>
					<li><a href={person.github}>GitHub</a></li>
				</ul>
			</section>
		</div>
	</main>
</div>

<style>
.b {
	max-width: 64rem;
	margin: 0 auto;
	padding: 4rem 1.5rem 3rem;
}

header {
	display: flex;
	flex-wrap: wrap;
	justify-content: space-between;
	align-items: baseline;
	gap: 1rem;
	margin-bottom: 6rem;
}

.name {
	margin: 0;
	font-weight: 600;
}

.name span {
	margin-left: 0.75rem;
	font-weight: 400;
	color: var(--muted);
}

nav {
	display: flex;
	gap: 1.25rem;
}

nav a {
	color: var(--muted);
	text-decoration: none;
}

nav a:hover {
	color: var(--text);
}

h1 {
	max-width: 22ch;
	margin: 0 0 1.5rem;
	font-size: clamp(1.75rem, 1.2rem + 2.2vw, 2.75rem);
	font-weight: 500;
	line-height: 1.15;
	letter-spacing: -0.02em;
}

.support {
	max-width: 38rem;
	margin: 0;
	color: var(--muted);
}

.columns {
	display: grid;
	grid-template-columns: repeat(3, minmax(0, 1fr));
	gap: 2.5rem;
	margin-top: 5rem;
}

h2 {
	margin: 0 0 1rem;
	font-size: 0.875rem;
	font-weight: 500;
	color: var(--muted);
}

ul {
	display: grid;
	gap: 1.5rem;
	margin: 0;
	padding: 0;
	list-style: none;
}

.columns section:last-child ul {
	gap: 0.5rem;
}

li a {
	font-weight: 600;
	text-decoration: none;
}

li a:hover {
	text-decoration: underline;
}

p {
	margin: 0.25rem 0 0;
}

.meta {
	font-size: 0.875rem;
	color: var(--muted);
}

@media (max-width: 48rem) {
	header {
		margin-bottom: 4rem;
	}

	.columns {
		grid-template-columns: minmax(0, 1fr);
		margin-top: 4rem;
	}
}
</style>
