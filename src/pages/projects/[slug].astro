---
import { type CollectionEntry, getCollection, render } from "astro:content";
import { STATUS_LABELS } from "@/consts";
import Base from "@/layouts/Base.astro";

export async function getStaticPaths() {
	const projects = await getCollection("projects");
	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

interface Props {
	project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, problem, role, decisions, stack, status, links } =
	project.data;
---

<Base title={`${title} — Joel Rodríguez`} description={description}>
	<article class="prose">
		<h1>{title}</h1>
		<p class="support">{description}</p>
		<p class="links">
			{links.repo && <a href={links.repo}>Repository</a>}
			{links.spec && <a href={links.spec}>Spec</a>}
			{links.live && <a href={links.live}>Live site</a>}
		</p>

		<h2>Problem</h2>
		<p>{problem}</p>

		<h2>What I built</h2>
		<Content />
		<p>My role: {role}</p>

		<h2>Key decisions</h2>
		<ul class="decisions">
			{decisions.map((decision) => (
				<li>
					<h3>{decision.title}</h3>
					<p>{decision.why}</p>
				</li>
			))}
		</ul>

		<h2>Stack</h2>
		<ul>
			{stack.map((tech) => <li>{tech}</li>)}
		</ul>

		<h2>Status</h2>
		<p>{STATUS_LABELS[status]}</p>
	</article>
</Base>

<style>
.links {
	display: flex;
	flex-wrap: wrap;
	gap: 1.25rem;
	margin-top: 1rem;
}

.decisions {
	padding-left: 0;
	list-style: none;
}
</style>
