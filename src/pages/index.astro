---
import { getCollection } from "astro:content";
import ProjectList from "@/components/ProjectList.astro";
import { EMAIL } from "@/consts";
import Base from "@/layouts/Base.astro";

const projects = await getCollection("projects");
---

<Base
	title="Joel Rodríguez — Full-stack developer"
	description="I model how a business actually works, then build the software on top. 10 years of experience, today with Next.js, TypeScript and Supabase."
>
	<h1>
		I model how a business <em>actually</em> works, then build the software on
		top.
	</h1>
	<p class="support">
		I've built web applications for 10 years: the first seven leading frontend,
		the last three across the full stack. Today I work with Next.js, TypeScript
		and Supabase, alongside AI coding agents.
	</p>
	<h2>Projects</h2>
	<ProjectList projects={projects} />
	<p class="cta">
		Have a role or a project in mind? <a href={`mailto:${EMAIL}`}>Email me</a>.
	</p>
</Base>

<style>
h2 {
	margin: 5rem 0 1rem;
	font-size: 0.875rem;
	font-weight: 500;
	color: var(--muted);
}

@media (max-width: 48rem) {
	h2 {
		margin-top: 4rem;
	}
}

.cta {
	margin-top: 3rem;
}
</style>
