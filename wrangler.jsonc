{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "joelrdz",
	"compatibility_date": "2026-09-26",
	"workers_dev": true,
	"preview_urls": false,
	"routes": [{ "pattern": "joelrdz.com", "custom_domain": true }],
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page"
	}
}
